# Local (Air / go run ./cmd/web). Defaults match this file if unset.
ADDR=:8080
DATA_DIR=data

# Vercel hosted DB (set in the project dashboard after linking — do not commit secrets).
# SQLite on the function filesystem is ephemeral. Use Marketplace Turso/libSQL when ready:
#   vercel integration add turso
# DATABASE_URL=libsql://YOUR-DB.turso.io
# TURSO_DATABASE_URL=libsql://YOUR-DB.turso.io
# TURSO_AUTH_TOKEN=

# HTTPS cookies. On Vercel, VERCEL=1 already forces Secure. Set locally only if serving TLS.
# COOKIE_SECURE=1

# Optional override for templates / static / locales / migrations (repo root by default).
# ASSET_ROOT=.
